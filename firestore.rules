rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roleName) {
      return isSignedIn() && currentUserData().role == roleName;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isStudent() {
      return hasRole('student');
    }

    // 1.1 Alumni Profiles: Publicly readable for FrontPage; only Admin can write.
    match /alumni_profiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 1.2 & 3.1 Users & Subcollections
    // Note: Read access allows Android APK REST sync & teacher class-roster queries;
    // writes are strictly restricted to the user themselves or an Admin (or teacher removing a student from their class).
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if (
        (isSignedIn() && (
          request.auth.uid == userId ||
          isAdmin() ||
          (isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedClassCodes']))
        )) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pendingOtpVerification',
          'isEmailVerified',
          'emailVerifiedAt',
          'authCredentialToken',
          'mustSetupPassword',
          'passwordUpdatedAt'
        ])
      );
      allow delete: if isAdmin();

      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 1.3 Teacher Account Requests:
    // Submitted from LoginScreen without plaintext passwords; managed by Admin.
    match /teacher_requests/{requestId} {
      allow read: if true;
      allow create: if !('password' in request.resource.data)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.email is string
                    && request.resource.data.name is string;
      allow update, delete: if isAdmin();
    }

    // 1.4 System Activity Logs:
    // Allows authenticated logs and strictly schema-validated LOGIN_FAILED / TEACHER_REQUEST logs.
    match /system_logs/{logId} {
      allow read: if true;
      allow create: if isSignedIn() || (
        request.resource.data.category in ['LOGIN_FAILED', 'TEACHER_REQUEST'] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() < 400 &&
        !('password' in request.resource.data)
      );
      allow update, delete: if isAdmin();
    }

    // 2.1 Classes:
    match /classes/{classCode} {
      allow read: if true;
      allow create: if isAdmin() || isTeacher();
      allow update, delete: if isAdmin() || (
        isTeacher() && (
          !('teacherId' in resource.data) ||
          resource.data.teacherId == '' ||
          resource.data.teacherId == request.auth.uid
        )
      );
    }

    // 2.2 & 2.5 Modules & File Chunks:
    match /modules/{moduleId} {
      allow read: if true;
      allow create: if isAdmin() || isTeacher();
      allow update, delete: if isAdmin() || (
        isTeacher() && (
          !('teacherId' in resource.data) ||
          resource.data.teacherId == '' ||
          resource.data.teacherId == request.auth.uid
        )
      );

      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if isAdmin() || isTeacher();
      }
    }
  }
}
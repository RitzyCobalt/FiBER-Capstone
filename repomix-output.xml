  Future< void > _openForgotPasswordScreen() async {
    final recoveredEmail = await Navigator.push< String >(
      context,
      MaterialPageRoute(
        builder: (_) => ForgotPasswordScreen(
          initialEmail: _emailCtrl.text.trim(),
        ),
      ),
    );
    if (!mounted) return;
    if (recoveredEmail != null && recoveredEmail.trim().isNotEmpty) {
      setState(() {
        _isSignUp = false;
        _emailCtrl.text = recoveredEmail.trim();
        _passwordCtrl.clear();
      });
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            '✅ Password reset complete for $recoveredEmail! Please sign in with your new password.',
          ),
          backgroundColor: Colors.green.shade700,
        ),
      );
    }
  }


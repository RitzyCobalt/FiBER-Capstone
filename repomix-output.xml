                      ),
                      child: LayoutBuilder(
                        builder: (context, barConstraints) {
                          final maxTravel =
                              (barConstraints.maxWidth - 84).clamp(0.0, 600.0);
                          return Stack(
                            alignment: Alignment.centerLeft,
                            children: [
                              AnimatedPositioned(
                                duration: const Duration(milliseconds: 420),
                                curve: Curves.easeOutBack,
                                left: maxTravel * sharkDanger,
                                child: Row(
                                  children: [
                                    Text(
                                      '🦈',
                                      style: TextStyle(
                                        fontSize: isCompactPhone ? 24 : 28,
                                      ),
                                    ),
                                    const SizedBox(width: 4),
                                    const Icon(
                                      Icons.double_arrow_rounded,
                                      color: Colors.cyanAccent,
                                      size: 16,
                                    ),
                                  ],
                                ),
                              ),
                              Positioned(
                                right: 4,
                                child: Text(
                                  '🐟',
                                  style: TextStyle(
                                    fontSize: isCompactPhone ? 22 : 26,
                                  ),
                                ),
                              ),
                            ],
                          );
                        },
                      ),
                    ),
                    SizedBox(height: isCompactPhone ? 8 : 12),

                    // ── Dynamic Scrollable Clue, Slots & Shuffled Letter Bank ──
                    Expanded(
                      child: SingleChildScrollView(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.stretch,
                          children: [
                            Container(
                              padding: EdgeInsets.all(isCompactPhone ? 14 : 18),
                              decoration: BoxDecoration(
                                color: Colors.white,
                                borderRadius: BorderRadius.circular(20),
                                boxShadow: [
                                  BoxShadow(
                                    color: Colors.black.withOpacity(0.15),
                                    blurRadius: 12,
                                    offset: const Offset(0, 6),
                                  ),
                                ],
                              ),
                              child: Column(
                                children: [
                                  Container(
                                    padding: const EdgeInsets.symmetric(
                                      horizontal: 10,
                                      vertical: 4,
                                    ),
                                    decoration: BoxDecoration(
                                      color: const Color(0xFFE1F5FE),
                                      borderRadius: BorderRadius.circular(20),
                                    ),
                                    child: Text(
                                      '${currentQ.subject.toUpperCase()} • ${currentQ.term.length} LETTERS',

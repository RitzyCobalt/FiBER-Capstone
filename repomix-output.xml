class WordHuntGame extends StatefulWidget {
  const WordHuntGame({super.key});

  @override
  State< WordHuntGame > createState() => _WordHuntGameState();
}

class WordHuntLevel {
  final int level;
  final int gridSize;
  final int wordCount;
  final int minWordLength;
  final int maxWordLength;
  final int timeLimit;

  const WordHuntLevel({
    required this.level,
    required this.gridSize,
    required this.wordCount,
    required this.minWordLength,
    required this.maxWordLength,
    required this.timeLimit,
  });

  /// Dynamically generates progressive difficulty across all 100 levels.
  factory WordHuntLevel.forLevel(int levelNumber) {
    final lvl = levelNumber.clamp(1, 100);
    if (lvl <= 10) {
      return WordHuntLevel(
        level: lvl,
        gridSize: 6,
        wordCount: 3 + (lvl >= 6 ? 1 : 0),
        minWordLength: 3,
        maxWordLength: 5 + (lvl >= 5 ? 1 : 0),
        timeLimit: 180,
      );
    } else if (lvl <= 25) {
      return WordHuntLevel(
        level: lvl,
        gridSize: 7,
        wordCount: 4 + (lvl >= 18 ? 1 : 0),
        minWordLength: 3,
        maxWordLength: 7,
        timeLimit: 195,
      );
    } else if (lvl <= 50) {
      return WordHuntLevel(
        level: lvl,
        gridSize: 8,
        wordCount: 5 + (lvl >= 38 ? 1 : 0),
        minWordLength: 3,
        maxWordLength: 8,
        timeLimit: 210,
      );
    } else if (lvl <= 75) {
      return WordHuntLevel(
        level: lvl,
        gridSize: 9,
        wordCount: 6 + (lvl >= 62 ? 1 : 0),
        minWordLength: 4,
        maxWordLength: 9,
        timeLimit: 225,
      );
    } else {
      return WordHuntLevel(
        level: lvl,
        gridSize: 10,
        wordCount: 7 + (lvl >= 90 ? 1 : 0),
        minWordLength: 4,
        maxWordLength: 10,
        timeLimit: 240,
      );
    }
  }
}

class _CellPosition {
  final int row;
  final int col;

  const _CellPosition(this.row, this.col);

  @override
  bool operator ==(Object other) =>
      other is _CellPosition && other.row == row && other.col == col;

  @override
  int get hashCode => Object.hash(row, col);
}

class _GridCell {
  final int row;
  final int col;
  String? letter;

  _GridCell(this.row, this.col, [this.letter]);
}


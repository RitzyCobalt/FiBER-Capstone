                                      return GestureDetector(
                                        onTap: () =>
                                            _removeTileFromSlot(slotIdx),
                                        child: AnimatedContainer(
                                          duration: const Duration(
                                            milliseconds: 150,
                                          ),
                                          width: maxTileWidth,
                                          height: tileHeight,
                                          alignment: Alignment.center,
                                          decoration: BoxDecoration(
                                            color: placedTile != null

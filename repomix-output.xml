                        ChoiceChip(
                          label: const Text('Mock Exams'),
                          selected: _historyFilter == 'mock_exam',
                          onSelected: (_) =>
                              setState(() => _historyFilter = 'mock_exam'),
                        ),
                        ChoiceChip(
                          label: const Text('Mini Quizzes'),
                          selected: _historyFilter == 'quiz',
                          onSelected: (_) =>
                              setState(() => _historyFilter = 'quiz'),

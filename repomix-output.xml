                                      ? Colors.green.shade600
                                      : Colors.red.shade600,
                                  borderRadius: BorderRadius.circular(14),
                                ),
                                child: Row(
                                  children: [
                                    Icon(
                                      _feedbackIsPositive
                                          ? Icons.check_circle_rounded
                                          : Icons.warning_amber_rounded,
                                      color: Colors.white,
                                    ),
                                    const SizedBox(width: 8),

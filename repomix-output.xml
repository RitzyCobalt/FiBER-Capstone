                              padding: EdgeInsets.all(isCompactPhone ? 10 : 14),
                              decoration: BoxDecoration(
                                color: Colors.white.withOpacity(0.1),
                                borderRadius: BorderRadius.circular(18),
                                border: Border.all(color: Colors.white24),
                              ),
                              child: Column(
                                children: [
                                  Wrap(
                                    spacing: 7,
                                    runSpacing: 7,
                                    alignment: WrapAlignment.center,
                                    children: _availableTiles.map((tile) {
                                      final used = _isTilePlaced(tile);
                                      final tileWidget = Container(
                                        width: maxTileWidth + 2,
                                        height: tileHeight,
                                        alignment: Alignment.center,
                                        decoration: BoxDecoration(
                                          gradient: used
                                              ? null
                                              : const LinearGradient(
                                                  colors: [
                                                    Color(0xFFFFB300),
                                                    Color(0xFFF57C00),
                                                  ],
                                                  begin: Alignment.topLeft,
                                                  end: Alignment.bottomRight,
                                                ),
                                          color: used ? Colors.white12 : null,
                                          borderRadius:
                                              BorderRadius.circular(11),
                                          boxShadow: used
                                              ? null
                                              : [
                                                  BoxShadow(
                                                    color: Colors.black
                                                        .withOpacity(0.2),
                                                    blurRadius: 4,
                                                    offset:
                                                        const Offset(0, 2),
                                                  ),
                                                ],
                                        ),
                                        child: Text(
                                          used ? '' : tile.letter,
                                          style: const TextStyle(
                                            fontSize: 19,
                                            fontWeight: FontWeight.bold,
                                            color: Colors.white,
                                          ),
                                        ),
                                      );

                                      if (used || _questionLocked) {
                                        return tileWidget;
                                      }

                                      return Draggable< _TileData >(
                                        data: tile,
                                        feedback: Material(
                                          color: Colors.transparent,
                                          child: Transform.scale(
                                            scale: 1.15,
                                            child: tileWidget,
                                          ),
                                        ),
                                        childWhenDragging: Opacity(
                                          opacity: 0.3,
                                          child: tileWidget,
                                        ),
                                        child: GestureDetector(
                                          onTap: () =>
                                              _tapTileToNextEmptySlot(tile),
                                          child: tileWidget,
                                        ),
                                      );
                                    }).toList(),
                                  ),
                                  const SizedBox(height: 8),
                                  Wrap(
                                    spacing: 12,
                                    alignment: WrapAlignment.center,
                                    children: [
                                      TextButton.icon(
                                        onPressed: _questionLocked
                                            ? null
                                            : _clearAllSlots,
                                        icon: const Icon(
                                          Icons.backspace_outlined,
                                          size: 16,
                                          color: Colors.cyanAccent,
                                        ),
                                        label: const Text(
                                          'Clear Letters',
                                          style: TextStyle(
                                            color: Colors.cyanAccent,
                                          ),
                                        ),
                                      ),
                                      TextButton.icon(
                                        onPressed: _questionLocked
                                            ? null
                                            : () {
                                                SoundService.playTap();
                                                setState(() {
                                                  _availableTiles
                                                      .shuffle(_random);
                                                });
                                              },
                                        icon: const Icon(
                                          Icons.shuffle_rounded,
                                          size: 16,
                                          color: Colors.amberAccent,
                                        ),
                                        label: const Text(
                                          'Shuffle Choices',
                                          style: TextStyle(
                                            color: Colors.amberAccent,
                                          ),
                                        ),
                                      ),
                                    ],
                                  ),
                                ],
                              ),
                            ),
                          ],
                        ),
                      ),
                    ),
                  ],
                ),
              );
            },
          ),
        ),
      ),
    );
  }


                          final title = m.title.toLowerCase();
                          final code = (m.classCode ?? '').toLowerCase();
                          final type = (m.fileType ?? '').toLowerCase();
                          return title.contains(query) ||
                              code.contains(query) ||
                              type.contains(query);

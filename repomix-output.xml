                      ...filteredResults.map((raw) {
                        final r = Map< String, dynamic >.from(raw as Map);
                        final type = (r['type'] ?? 'quiz')
                            .toString()
                            .toUpperCase()
                            .replaceAll('_', ' ');
                        final subject =
                            (r['moduleTitle'] ?? r['subject'] ?? 'General')
                                .toString();
                        final score = r['score'] ?? 0;
                        final total = r['total'] ?? 0;
                        final pct =
                            (r['percentage'] as num?)?.toDouble() ?? 0.0;
                        final durationSec =
                            (r['durationSeconds'] as num?)?.toInt() ?? 0;
                        final hasDetails =
                            (r['answerDetails'] as List< dynamic >? ?? const [])
                                .isNotEmpty;

                        return Container(
                          margin: const EdgeInsets.only(bottom: 8),
                          decoration: BoxDecoration(
                            color: const Color(0xFFF8FBFF),
                            borderRadius: BorderRadius.circular(12),
                            border: Border.all(
                              color: type.contains('EXAM')
                                  ? Colors.deepPurple.shade100
                                  : Colors.lightBlue.shade100,
                            ),
                          ),
                          child: ListTile(
                            onTap: hasDetails
                                ? () => _showTeacherExamAnswerReview(r)
                                : null,
                            leading: CircleAvatar(
                              backgroundColor: type.contains('EXAM')
                                  ? Colors.deepPurple.withOpacity(0.15)
                                  : Colors.blue.withOpacity(0.15),
                              child: Icon(
                                type.contains('EXAM')
                                    ? Icons.assignment
                                    : Icons.quiz,
                                color: type.contains('EXAM')
                                    ? Colors.deepPurple
                                    : Colors.blue,
                              ),
                            ),
                            title: Text(
                              '$type — $subject',
                              style: const TextStyle(
                                fontWeight: FontWeight.w600,
                                fontSize: 14,
                              ),
                            ),
                            subtitle: Text(
                              'Score: $score / $total (${pct.toStringAsFixed(1)}%) • ${ durationSec > 0 ? "${DataService.formatStudySeconds(durationSec)} • " : ""}${_formatExamDate(r)}',
                              style: const TextStyle(fontSize: 12),
                            ),
                            trailing: hasDetails
                                ? const Icon(
                                    Icons.chevron_right_rounded,
                                    color: Color(0xFF0277BD),
                                  )
                                : null,
                          ),
                        );
                      }),
                  ],
                ),
              );
            },
          ),
        ],
      ),
    );
  }

  Widget _metricTile({
    required IconData icon,
    required String label,
    required String value,
    required Color color,
  }) {
    return Container(
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(14),
      ),
      child: Column(
        children: [
          Icon(icon, color: color, size: 24),
          const SizedBox(height: 6),
          Text(
            value,
            style: TextStyle(
              fontWeight: FontWeight.bold,
              fontSize: 15,
              color: color,
            ),
          ),
          const SizedBox(height: 2),
          Text(
            label,
            style: const TextStyle(fontSize: 11, color: Colors.black54),
          ),
        ],
      ),
    );
  }
}
